<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lidar_obstacle_detector</name>
  <version>2.0.0</version>
  <description>
    3D LiDAR obstacle detection and tracking: ground segmentation (Patchwork++ / RANSAC),
    clustering (Euclidean / adaptive / BEV grid), L-shape bounding boxes and Kalman-filter
    multi-object tracking. ROS-agnostic core with ROS 1 (Noetic) and ROS 2 (Humble, Jazzy) nodes.
  </description>
  <maintainer email="ss1057532022@gmail.com">Shuo Sun</maintainer>
  <license>MIT</license>
  <license file="third_party/patchworkpp/LICENSE">BSD-2-Clause</license>
  <url type="website">https://github.com/SS47816/lidar_obstacle_detector</url>
  <url type="bugtracker">https://github.com/SS47816/lidar_obstacle_detector/issues</url>
  <author>Shuo Sun</author>

  <buildtool_depend condition="$ROS_VERSION == 1">catkin</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake</buildtool_depend>

  <!-- core -->
  <depend>eigen</depend>
  <depend>libpcl-all-dev</depend>

  <!-- common to both ROS versions -->
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>

  <!-- ROS 1 -->
  <depend condition="$ROS_VERSION == 1">roscpp</depend>
  <depend condition="$ROS_VERSION == 1">dynamic_reconfigure</depend>
  <depend condition="$ROS_VERSION == 1">jsk_recognition_msgs</depend>
  <exec_depend condition="$ROS_VERSION == 1">rqt_reconfigure</exec_depend>

  <!-- ROS 2 -->
  <depend condition="$ROS_VERSION == 2">rclcpp</depend>
  <depend condition="$ROS_VERSION == 2">rclcpp_components</depend>
  <depend condition="$ROS_VERSION == 2">vision_msgs</depend>
  <depend condition="$ROS_VERSION == 2">autoware_perception_msgs</depend>
  <exec_depend condition="$ROS_VERSION == 2">launch_ros</exec_depend>

  <test_depend condition="$ROS_VERSION == 1">rosunit</test_depend>
  <test_depend condition="$ROS_VERSION == 2">ament_cmake_gtest</test_depend>

  <export>
    <build_type condition="$ROS_VERSION == 1">catkin</build_type>
    <build_type condition="$ROS_VERSION == 2">ament_cmake</build_type>
  </export>
</package>
